# Copy to .env. Never commit your real keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact Google email addresses allowed to sign in.
ALLOWED_EMAILS=
# Optional private account. Match its email to the existing Google account.
LOCAL_LOGIN_USERNAME=
LOCAL_LOGIN_EMAIL=
# Base64-encoded BCrypt hash (cost 12). Never enter a plain password.
LOCAL_LOGIN_PASSWORD_HASH_BASE64=
APP_BASE_URL=http://localhost:8085
APP_PORT=8085
# Set true only when the browser connects over HTTPS.
COOKIE_SECURE=false
# Cloudflare dashboard > Tunnel > connector token (not the Global API Key).
# Used only with compose.cloudflare.yaml or the Windows Cloudflare scripts.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_URL=https://ctfmon.shop
# scripts/setup.ps1 generates these locally.
DB_PASSWORD=replace-with-random-password
TOKEN_ENCRYPTION_KEY=
# true: isolated sample session, no Google access. Set false for real accounts.
DEMO_MODE=true
